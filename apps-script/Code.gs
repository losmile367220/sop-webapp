const CONFIG={INDEX_SPREADSHEET_ID:"PASTE_YOUR_INDEX_SPREADSHEET_ID_HERE",SHEET_NAMES:{SOP:"SOP",DATABASE:"Database",USERS:"Users"}};function doGet(e){try{const a=e.parameter.action||"",t=e.parameter.token||"",p=JSON.parse(decodeURIComponent(e.parameter.payload||"%7B%7D")),u=verifyGoogleToken_(t);assertAuthorized_(u.email);let r;if(a==="getIndex")r=getIndex_();else if(a==="getDoc")r=getDoc_(p.url);else if(a==="getDatabase")r=getDatabase_(p.url);else if(a==="search")r=search_(p.keyword||"");else throw new Error("未知操作");return json_({ok:true,...r})}catch(err){return json_({ok:false,message:err.message})}}function json_(o){return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON)}function verifyGoogleToken_(t){if(!t)throw new Error("尚未登入");const r=UrlFetchApp.fetch("https://oauth2.googleapis.com/tokeninfo?id_token="+encodeURIComponent(t),{muteHttpExceptions:true});if(r.getResponseCode()!==200)throw new Error("登入已失效，請重新登入");return JSON.parse(r.getContentText())}function assertAuthorized_(email){const s=SpreadsheetApp.openById(CONFIG.INDEX_SPREADSHEET_ID).getSheetByName(CONFIG.SHEET_NAMES.USERS);if(!s)throw new Error("找不到 Users 工作表");const v=s.getDataRange().getDisplayValues(),h=v.shift().map(x=>x.trim()),i=h.indexOf("Email");if(!v.some(r=>String(r[i]||"").trim().toLowerCase()===String(email).trim().toLowerCase()))throw new Error("此帳號沒有使用權限")}function getIndex_(){const ss=SpreadsheetApp.openById(CONFIG.INDEX_SPREADSHEET_ID),items=[];const sop=ss.getSheetByName(CONFIG.SHEET_NAMES.SOP);if(sop)toObjects_(sop).forEach(r=>{if(r["SOP名稱"])items.push({category:r["大分類"]||"",name:r["SOP名稱"],type:"doc",url:r["Google Docs網址"]||r["Google Docs 完整網址"]||""})});const db=ss.getSheetByName(CONFIG.SHEET_NAMES.DATABASE);if(db)toObjects_(db).forEach(r=>{if(r["名稱"])items.push({category:r["大分類"]||"",name:r["名稱"],type:"database",url:r["Google Sheet網址"]||"",isEmpty:String(r["暫時內容"]||"").toUpperCase()==="TRUE"})});return{items}}function getDoc_(url){const id=extractId_(url),b=DocumentApp.openById(id).getBody();let h="";for(let i=0;i<b.getNumChildren();i++)h+=elementToHtml_(b.getChild(i));return{html:h}}function getDatabase_(url){const id=extractId_(url),s=SpreadsheetApp.openById(id).getSheets()[0],v=s.getDataRange().getDisplayValues();if(!v.length||v.every(r=>r.every(c=>!c)))return{html:"<div class='empty-state'><h3>內容準備中</h3><p>此測項目前尚未加入內容。</p></div>"};let h="<table>";v.forEach((r,ri)=>{h+="<tr>";r.forEach(c=>{const t=ri===0?"th":"td";h+=`<${t}>${escapeHtml_(c)}</${t}>`});h+="</tr>"});return{html:h+"</table>"}}function search_(k){k=String(k||"").trim().toLowerCase();if(!k)return{items:[]};const idx=getIndex_().items,res=[];idx.forEach(i=>{if(`${i.category} ${i.name}`.toLowerCase().includes(k)){res.push(i);return}try{if(i.type==="doc"&&i.url&&DocumentApp.openById(extractId_(i.url)).getBody().getText().toLowerCase().includes(k))res.push(i)}catch(e){}});return{items:res}}function toObjects_(s){const v=s.getDataRange().getDisplayValues();if(!v.length)return[];const h=v.shift().map(x=>x.trim());return v.map(r=>{const o={};h.forEach((x,i)=>o[x]=r[i]);return o})}function extractId_(u){const m=String(u||"").match(/[-\w]{25,}/);if(!m)throw new Error("無法從連結取得檔案 ID");return m[0]}function elementToHtml_(e){const t=e.getType();if(t===DocumentApp.ElementType.PARAGRAPH){const p=e.asParagraph(),txt=escapeHtml_(p.getText()),m={};m[DocumentApp.ParagraphHeading.TITLE]="h1";m[DocumentApp.ParagraphHeading.HEADING1]="h1";m[DocumentApp.ParagraphHeading.HEADING2]="h2";m[DocumentApp.ParagraphHeading.HEADING3]="h3";const tag=m[p.getHeading()]||"p";return`<${tag}>${txt}</${tag}>`}if(t===DocumentApp.ElementType.LIST_ITEM)return`<p>• ${escapeHtml_(e.asListItem().getText())}</p>`;if(t===DocumentApp.ElementType.TABLE){const tb=e.asTable();let h="<table>";for(let r=0;r<tb.getNumRows();r++){h+="<tr>";const row=tb.getRow(r);for(let c=0;c<row.getNumCells();c++)h+=`<td>${escapeHtml_(row.getCell(c).getText())}</td>`;h+="</tr>"}return h+"</table>"}return""}function escapeHtml_(s){return String(s||"").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&#039;")}